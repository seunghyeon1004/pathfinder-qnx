# Container that hosts the x86_64 QNX SDP 8.0 toolchain on Apple Silicon (install the SDP into a volume with the QNX Software Center CLI, see docs/RUN.md)
FROM --platform=linux/amd64 ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget xz-utils file unzip sudo less procps \
    libgl1 libxkbcommon-x11-0 libxcb-xinerama0 libxcb-cursor0 libfontconfig1 libdbus-1-3 libnss3 libglib2.0-0 \
    xvfb xauth x11-utils \
    qemu-system-x86 qemu-utils python3 make git \
 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash qnx
USER qnx
WORKDIR /home/qnx
